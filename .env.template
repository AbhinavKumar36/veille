# =============================================================
# CRIMENET v4.0 — Environment Configuration Template
# =============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.template .env
#   2. Fill in your real values below
#   3. NEVER commit .env to version control
# =============================================================

# --- PostgreSQL (System of Record) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimenet_db
POSTGRES_USER=crimenet
POSTGRES_PASSWORD=crimenet_password

# Full connection URL used by SQLAlchemy
DATABASE_URL=postgresql://crimenet:crimenet_password@localhost:5432/crimenet_db

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimenet_graph

# --- Redis (Job Queue / Cache / DLQ) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=crimenet-evidence

# --- Kafka (CDR Streaming Pipeline) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CDR_TOPIC=crimenet_cdr_stream
KAFKA_GROUP_ID=crimenet-consumers

# --- Google Gemini AI ---
GEMINI_API_KEY=CHANGE_ME_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# --- JWT Authentication ---
# IMPORTANT: Change this to a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Admin Bootstrap (used by seed script on first run) ---
ADMIN_EMAIL=admin@crimenet.gov.in
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- OpenTelemetry (Observability — Phase 4) ---
# Uncomment when Jaeger is running
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=crimenet-backend
