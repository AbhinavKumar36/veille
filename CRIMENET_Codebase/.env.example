# =============================================================
# VEILLE v4.0 — Environment Configuration Example
# Copy this file to .env and fill in the values
# =============================================================

# --- PostgreSQL (System of Record) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=veille_db
POSTGRES_USER=veille
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://veille:your_secure_postgres_password_here@localhost:5432/veille_db

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here

# --- Redis (Job Queue / Cache / DLQ) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / S3 Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_NAME=veille-evidence

# --- Kafka (CDR Streaming Pipeline) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CDR_TOPIC=veille_cdr_stream
KAFKA_GROUP_ID=veille-consumers

# --- Google Gemini AI ---
# IMPORTANT: Never commit your actual API key!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- JWT Authentication ---
# Generate a random 64+ char string for production: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=your_long_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Application Settings ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:3000

# --- Admin Bootstrap ---
# Used only during initial seed. Should be strong in production.
ADMIN_EMAIL=admin@veille.gov.in
ADMIN_PASSWORD=your_secure_admin_password_here
