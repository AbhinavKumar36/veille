# ============================================================
# CRIMENET v4.0 — .gitignore
# ============================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
*.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/
.hypothesis/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# --- Virtual Environment ---
venv/
env/
ENV/
.venv/
.env/

# --- Node.js / Frontend ---
node_modules/
dist/
build/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Docker ---
# Don't ignore docker-compose files themselves, just local overrides
docker-compose.override.yml

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Local uploads / temp files ---
CRIMENET_Codebase/backend/tmp/
*.sqlite3
*.zip
chat*.txt

# --- Test artifacts ---
.pytest_cache/
htmlcov/
*.coveragerc
.coverage

# --- Alembic ---
# Keep versions tracked, but not compiled caches
CRIMENET_Codebase/backend/alembic/__pycache__/

